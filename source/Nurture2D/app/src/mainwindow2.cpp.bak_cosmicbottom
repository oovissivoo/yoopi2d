    const int toolboxColorRgba = mEditor->preference()->getInt(SETTING::TOOLBOX_SELECTION_COLOR);
    const QColor toolboxColor = QColor::fromRgba(toolboxColorRgba);
    
    const QString colorHexAlpha = QString("rgba(%1, %2, %3, %4)")
                                 .arg(toolboxColor.red()).arg(toolboxColor.green()).arg(toolboxColor.blue()).arg(0.12);
    const QString colorHexAlphaHover = QString("rgba(%1, %2, %3, %4)")
                                      .arg(toolboxColor.red()).arg(toolboxColor.green()).arg(toolboxColor.blue()).arg(0.28);
    const QString colorHexAlphaChecked = QString("rgba(%1, %2, %3, %4)")
                                        .arg(toolboxColor.red()).arg(toolboxColor.green()).arg(toolboxColor.blue()).arg(0.45);
    const QString colorHexBorder = QString("rgba(%1, %2, %3, %4)")
                                  .arg(toolboxColor.red()).arg(toolboxColor.green()).arg(toolboxColor.blue()).arg(0.35);
    const QString colorHexBorderChecked = QString("rgba(%1, %2, %3, %4)")
                                         .arg(toolboxColor.red()).arg(toolboxColor.green()).arg(toolboxColor.blue()).arg(0.85);
    const QString colorHexBorderCheckedHover = QString("rgba(%1, %2, %3, %4)")
                                              .arg(toolboxColor.red()).arg(toolboxColor.green()).arg(toolboxColor.blue()).arg(1.0);
    
