void MainWindow2::openCanvasSizeDialog()
{
    // Find the last-used/nearest camera layer. Fallback to first camera layer.
    Layer* layer = mEditor->layers()->getLastCameraLayer();
    if (!layer) {
        // No camera layer found, nothing to do
        return;
    }
    auto cameraLayer = dynamic_cast<LayerCamera*>(layer);
    Q_ASSERT(cameraLayer);

    CameraPropertiesDialog dialog(cameraLayer->name(), cameraLayer->getViewRect().width(), cameraLayer->getViewRect().height());
    if (dialog.exec() != QDialog::Accepted)
    {
        return;
    }

    // Apply the new size to the camera layer, mimicking existing behavior
    if (mEditor && mEditor->preference()) {
        mEditor->preference()->set(SETTING::FIELD_W, dialog.getWidth());
        mEditor->preference()->set(SETTING::FIELD_H, dialog.getHeight());
    } else {
        QSettings settings(PENCIL2D, PENCIL2D);
        settings.setValue(SETTING_FIELD_W, dialog.getWidth());
        settings.setValue(SETTING_FIELD_H, dialog.getHeight());
    }
    cameraLayer->setViewRect(QRect(-dialog.getWidth() / 2, -dialog.getHeight() / 2, dialog.getWidth(), dialog.getHeight()));
    mEditor->view()->forceUpdateViewTransform();
}

void MainWindow2::ensureMenubarUnobstructed()
{
    if (!ui || !ui->menuBar) return;
    // Elevate menubar in stacking order
    ui->menuBar->raise();
    // Make sure no floating dock starts at y==0 over the menubar region after restore
    const int menuHeight = ui->menuBar->height();
    for (BaseDockWidget* d : mDockWidgets)
    {
        if (d->isFloating())
        {
            QRect g = d->geometry();
            if (g.top() <= menuHeight) {
                g.moveTop(menuHeight + 8);
                d->setGeometry(g);
            }
        }
    }
}

void MainWindow2::toggleDocksVisibility()
{
    QSettings settings("Pencil2D", "Pencil2D");
    
    // Ignore visibility changes during programmatic toggle
    mIgnoreDockVisibilityChanges = true;
    
    if (!mDocksHidden)
    {
        // Hiding docks - capture current visible state
        mPreviouslyVisibleDocks.clear();
        
        // Default Toggle Taps states (must be kept in sync with ToggleTapsPage::updateValues)
        const QMap<QString, bool> defaultStates = {
            { QStringLiteral("CellStack"),       false },
            { QStringLiteral("ColorWheel"),      false },
            { QStringLiteral("Color Inspector"), false },
            { QStringLiteral("colorSlidersDock"), false },
            { QStringLiteral("ColorPalette"),    false },
            { QStringLiteral("Onion Skin"),      false },
            { QStringLiteral("Reference Window"), false },
            { QStringLiteral("Shift & Trace"),   false },
            { QStringLiteral("TimeLine"),        true  },
            { QStringLiteral("ToolBox"),         false },
            { QStringLiteral("ToolOption"),      false }
        };
        
        for (BaseDockWidget* dock : mDockWidgets)
        {
            if (dock && dock->isVisible() && dock != mColorInspector)
            {
                // Check if this dock should stay visible based on Toggle Taps preferences
                QString dockName = dock->objectName();
                const QString key = "ToggleTaps/" + dockName;
                QVariant stored = settings.value(key);
                bool keepVisible;

                if (!stored.isValid()) {
                    // First run or new dock: use default state and persist it
                    keepVisible = defaultStates.value(dockName, false);
                    settings.setValue(key, keepVisible);
                } else {
                    keepVisible = stored.toBool();
                }
                
                // If keepVisible is false, the dock should be hidden when toggling all docks
                if (!keepVisible)
                {
                    mPreviouslyVisibleDocks.append(dock);
                    dock->hide();
                }
            }
        }
        mDocksHidden = true;
        
        // Save state immediately so it persists across app restarts
        QStringList dockNames;
        for (BaseDockWidget* dock : mPreviouslyVisibleDocks) {
            if (dock) {
                dockNames.append(dock->objectName());
            }
        }
        settings.setValue("ToggleDocks/Hidden", true);
        settings.setValue("ToggleDocks/PreviouslyVisible", dockNames);
        settings.sync();
    }
    else
    {
        // Showing docks - restore previous state
        for (BaseDockWidget* dock : mPreviouslyVisibleDocks)
        {
            if (dock)
            {
                dock->show();
                dock->raise();
            }
        }
        mPreviouslyVisibleDocks.clear();
        mDocksHidden = false;
        
        // Clear saved state
        settings.setValue("ToggleDocks/Hidden", false);
        settings.remove("ToggleDocks/PreviouslyVisible");
        settings.sync();
    }
    
    // Re-enable visibility change detection
    mIgnoreDockVisibilityChanges = false;
}

void MainWindow2::onDockVisibilityChanged(bool visible)
{
    Q_UNUSED(visible);
    
    // Ignore visibility changes during initialization or programmatic toggles
    if (mIgnoreDockVisibilityChanges) {
        return;
    }
    
    // If docks are currently in "hidden" state and user manually shows/hides a dock,
    // treat the current layout as the new "unhidden" state (override safeguard)
    if (mDocksHidden)
    {
        QSettings settings("Pencil2D", "Pencil2D");
        
        // User manually changed dock visibility while in "hidden" mode
        // This means they want to override the toggle state
        // Clear the hidden state and treat current layout as the new baseline
        mPreviouslyVisibleDocks.clear();
        mDocksHidden = false;
        
        settings.setValue("ToggleDocks/Hidden", false);
        settings.remove("ToggleDocks/PreviouslyVisible");
        settings.sync();
        
        qDebug() << "Dock visibility manually changed - clearing toggle state (override safeguard)";
    }
}

void MainWindow2::restoreDockState()
{
    QSettings settings(PENCIL2D, PENCIL2D);

    // Detect if this is the first run (no saved window layout yet) so we can
    // apply safer defaults for optional panels like the Brush Factory.
    bool hasWindowState = settings.contains(SETTING_WINDOW_STATE);
    QVariant winState = settings.value(SETTING_WINDOW_STATE);
    restoreState(winState.toByteArray());

    // Restore per-dock floating lock state after layout has been restored
    for (BaseDockWidget* dock : mDockWidgets)
    {
        if (!dock) {
            continue;
        }
        const QString key = QString("DockFloatingLock/%1").arg(dock->objectName());
        bool locked = settings.value(key, false).toBool();
        dock->setFloatingLock(locked);
    }

    // On a true first run (no saved window state), force the Brush Factory
    // dock to start disabled so new users are not overwhelmed by an extra
    // floating panel. Users can enable it explicitly via the toggle.
    if (!hasWindowState) {
        if (mBrushFactoryDock) {
            mBrushFactoryDock->hide();
        }
        if (mToolOptions) {
            mToolOptions->setBrushFactoryToggleState(false);
        }
        mBrushFactoryLockActive = false;
    }

    // Restore toggle docks state AFTER restoring window state
    // This ensures docks are hidden if they were hidden when app closed
    mDocksHidden = settings.value("ToggleDocks/Hidden", false).toBool();
    if (mDocksHidden) {
        // Restore the list of previously visible docks by name
        QStringList dockNames = settings.value("ToggleDocks/PreviouslyVisible").toStringList();
        mPreviouslyVisibleDocks.clear();
        for (const QString& name : dockNames) {
            for (BaseDockWidget* dock : mDockWidgets) {
                if (dock && dock->objectName() == name) {
                    mPreviouslyVisibleDocks.append(dock);
                    break;
                }
            }
        }
        
        // Now hide the docks that should be hidden
        for (BaseDockWidget* dock : mPreviouslyVisibleDocks) {
            if (dock) {
                dock->hide();
            }
        }
        
        qDebug() << "Restored toggle state: mDocksHidden=" << mDocksHidden 
                 << "previouslyVisible count=" << mPreviouslyVisibleDocks.count()
                 << "- docks hidden";
    }

    // As a final safeguard after layout restoration, ensure the Brush Factory
    // dock is not visible while its toggle is OFF. This prevents a mismatch
    // where the dock appears active even though the controlling toggle is
    // disabled (e.g. on first launch or after layout changes).
    if (mBrushFactoryDock && mToolOptions) {
        QAbstractButton* bfToggle = mToolOptions->getBrushFactoryToggle();
        const bool toggleOn = bfToggle && bfToggle->isChecked();
        if (!toggleOn && mBrushFactoryDock->isVisible()) {
            mBrushFactoryDock->hide();
            mBrushFactoryLockActive = false;
        }
    }

    // Restore geometry AFTER dock state is restored.
    // This prevents the window from expanding due to dock changes before the main window is ready.
    QVariant winGeometry = settings.value(SETTING_WINDOW_GEOMETRY);
    restoreGeometry(winGeometry.toByteArray());

    // Validate restored geometry: if it's off-screen or too small, reset to a sensible default
    QRect geom = geometry();
    bool geometryValid = true;
    if (geom.width() < 200 || geom.height() < 200) geometryValid = false;
    if (geometryValid) {
        const auto screens = QGuiApplication::screens();
        bool intersects = false;
        for (QScreen* s : screens) {
            if (s->availableGeometry().intersects(geom)) { intersects = true; break; }
        }
        if (!intersects) geometryValid = false;
    }
    if (!geometryValid) {
        // Clear bad saved geometry so next run has a clean state
        settings.remove(SETTING_WINDOW_GEOMETRY);
        settings.remove(SETTING_WINDOW_STATE);
        // Apply a reasonable default size and center on primary screen
        QSize defaultSize(1200, 800);
        resize(defaultSize);
        if (QScreen* ps = QGuiApplication::primaryScreen()) {
            QRect av = ps->availableGeometry();
            move(av.x() + (av.width() - width())/2, av.y() + (av.height() - height())/2);
        }
    }

    // Re-enable dock visibility change detection after the event loop processes pending events.
    // This prevents any queued visibilityChanged() emissions triggered by restoreState() from
    // incorrectly tripping the override safeguard.
    QTimer::singleShot(0, this, [this]() {
        mIgnoreDockVisibilityChanges = false;
        qDebug() << "Dock visibility change detection re-enabled (restoreDockState)";
    });
}
