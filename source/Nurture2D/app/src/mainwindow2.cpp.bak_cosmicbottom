}

void MainWindow2::createToolbars()
{
    mMainToolbar = addToolBar(tr("Main Toolbar"));
    mMainToolbar->setObjectName("mMainToolbar");
    mMainToolbar->addAction(ui->actionNew);
    mMainToolbar->addAction(ui->actionOpen);
    mMainToolbar->addAction(ui->actionSave);
    mMainToolbar->addAction(ui->actionPaste);
    mMainToolbar->addAction(ui->actionClearFrame);

    // Tools toolbar pinned left
    mToolsToolbar = nullptr;

    // Create extra actions if not yet created
    if (!mActionPencil)     mActionPencil = new QAction(QIcon(":/icons/themes/playful/tools/tool-pencil.svg"), tr("Pencil"), this);
    if (!mActionCurve)      mActionCurve = new QAction(QIcon(":/CustomToolIcons/Curve.svg"), tr("Curve"), this);
    if (!mActionBSpline)    mActionBSpline = new QAction(QIcon(":/CustomToolIcons/Spline.svg"), tr("B-Spline"), this);
    if (!mActionRectGapFill) mActionRectGapFill = new QAction(QIcon(":/CustomToolIcons/RectangleFill.svg"), tr("Rect Gap Fill"), this);
    if (!mActionLassoGapFill) mActionLassoGapFill = new QAction(QIcon(":/CustomToolIcons/LassoFill.svg"), tr("Lasso Gap Fill"), this);
    if (!mActionDplate)     mActionDplate = new QAction(QIcon(":/CustomToolIcons/Dplate.svg"), tr("Dplate"), this);
    // Lasso Select action
    if (!mActionLassoSelect) mActionLassoSelect = new QAction(QIcon(":/CustomToolIcons/LassoSelect.svg"), tr("Lasso Select"), this);
    for (QAction* a : {mActionPencil, mActionCurve, mActionBSpline, mActionRectGapFill, mActionLassoGapFill}) a->setCheckable(true);
    mActionDplate->setCheckable(true);
    if (mActionLassoSelect) mActionLassoSelect->setCheckable(true);

    // Add extra tool actions to the global tools action group for mutual exclusivity
    if (mToolsActionGroup) {
        if (mActionPencil) mToolsActionGroup->addAction(mActionPencil);
        if (mActionCurve) mToolsActionGroup->addAction(mActionCurve);
        if (mActionBSpline) mToolsActionGroup->addAction(mActionBSpline);
        if (mActionRectGapFill) mToolsActionGroup->addAction(mActionRectGapFill);
        if (mActionLassoGapFill) mToolsActionGroup->addAction(mActionLassoGapFill);
        if (mActionDplate) mToolsActionGroup->addAction(mActionDplate);
        if (mActionLassoSelect) mToolsActionGroup->addAction(mActionLassoSelect);
        // Hide legacy Select/Move tool actions from the tools toolbar and
        // menus; Lasso Select replaces them as the primary selection tool.
        if (ui->actionMove) ui->actionMove->setVisible(false);
        if (ui->actionSelect) ui->actionSelect->setVisible(false);
    }

    // Place Lasso Select at the very top of the tools toolbar

    // Make the actions checkable to reflect the active tool
    // Order: LassoSelect, Select, Move, Pen, Pencil, Curve, Polyline, BSpline, Bucket, RectGapFill, LassoGapFill, Eraser, Hand, Eyedropper, Dplate
    const QList<QAction*> toolActions = {
        mActionLassoSelect,
        ui->actionPen,
        mActionPencil,
        mActionCurve,
        ui->actionPolyline,
        mActionBSpline,
        ui->actionBucket,
        mActionRectGapFill,
        mActionLassoGapFill,
        // Unspecified tools retain presence after the ordered list
        ui->actionEraser,
        ui->actionHand,
        ui->actionEyedropper,
        /* ui->actionSmudge, */
        mActionDplate
    };
    for (QAction* a : toolActions) { a->setCheckable(true); }
    if (mToolsToolbar) {
        mToolsToolbar->clear();
        for (QAction* a : toolActions) { if (a) mToolsToolbar->addAction(a); }
    }

    // Wire actions to set the corresponding tool via ToolBox logic
    connect(mActionPencil, &QAction::triggered, this, [this]{ mToolBox->setActiveTool(PENCIL); });
    connect(mActionCurve, &QAction::triggered, this, [this]{ mToolBox->setActiveTool(CURVE); });
    connect(mActionBSpline, &QAction::triggered, this, [this]{ mToolBox->setActiveTool(BSPLINE); });
    connect(mActionRectGapFill, &QAction::triggered, this, [this]{ mToolBox->setActiveTool(RECT_GAP_FILL); });
    connect(mActionLassoGapFill, &QAction::triggered, this, [this]{ mToolBox->setActiveTool(LASSO_GAP_FILL); });
    connect(mActionDplate, &QAction::triggered, this, [this]{ mToolBox->setActiveTool(DPLATE); });
    if (mActionLassoSelect) connect(mActionLassoSelect, &QAction::triggered, this, [this]{ mEditor->tools()->setCurrentTool(LASSO_SELECT); });

    // Sync checked state for ALL tool actions so only the active tool remains highlighted
    connect(mEditor->tools(), &ToolManager::toolChanged, this, [this](ToolType t){
        if (ui->actionSelect) ui->actionSelect->setChecked(t == SELECT);
        if (ui->actionMove) ui->actionMove->setChecked(t == MOVE || t == CAMERA);
        if (ui->actionPen) ui->actionPen->setChecked(t == PEN);
        if (mActionPencil) mActionPencil->setChecked(t == PENCIL);
        if (ui->actionPolyline) ui->actionPolyline->setChecked(t == POLYLINE);
        if (ui->actionBucket) ui->actionBucket->setChecked(t == BUCKET);
        if (ui->actionEraser) ui->actionEraser->setChecked(t == ERASER);
        if (ui->actionHand) ui->actionHand->setChecked(t == HAND);
        if (ui->actionEyedropper) ui->actionEyedropper->setChecked(t == EYEDROPPER);
        if (mActionCurve) mActionCurve->setChecked(t == CURVE);
        if (mActionBSpline) mActionBSpline->setChecked(t == BSPLINE);
        if (mActionRectGapFill) mActionRectGapFill->setChecked(t == RECT_GAP_FILL);
        if (mActionLassoGapFill) mActionLassoGapFill->setChecked(t == LASSO_GAP_FILL);
        if (mActionDplate) mActionDplate->setChecked(t == DPLATE);
        if (mActionLassoSelect) mActionLassoSelect->setChecked(t == LASSO_SELECT);
    });

    // Tools toolbar is now enabled by default
    // if (mToolsToolbar) { mToolsToolbar->hide(); }

    mViewToolbar = addToolBar(tr("View Toolbar"));
    mViewToolbar->setObjectName("mViewToolbar");
    mViewToolbar->addAction(ui->actionZoom_In);
    mViewToolbar->addAction(ui->actionZoom_Out);
    mViewToolbar->addAction(ui->actionReset_View);
    mViewToolbar->addSeparator();
    mViewToolbar->addAction(ui->actionHorizontal_Flip);
    mViewToolbar->addAction(ui->actionVertical_Flip);
    mViewToolbar->addSeparator();
    mViewToolbar->addAction(ui->actionShowInvisibleLines);
    mViewToolbar->addAction(ui->actionShowOutlinesOnly);

    mOverlayToolbar = addToolBar(tr("Overlay Toolbar"));
    mOverlayToolbar->setObjectName("mOverlayToolbar");
    mOverlayToolbar->addAction(ui->actionGrid);
    mOverlayToolbar->addAction(ui->actionCenter);
    mOverlayToolbar->addAction(ui->actionThirds);
    mOverlayToolbar->addAction(ui->actionGoldenRatio);
    mOverlayToolbar->addAction(ui->actionSafeAreas);
    mOverlayToolbar->addAction(ui->actionOnePointPerspective);
    mOverlayToolbar->addAction(ui->actionTwoPointPerspective);
