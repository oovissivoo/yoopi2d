void MainWindow2::importSingleImage()
{
    // Open file dialog for single image import
    const QString filePath = FileDialog::getOpenFileName(this, FileType::IMAGE);
    if (filePath.isEmpty()) {
        return; // user canceled
    }

    // Create a new bitmap layer named after the file (without extension)
    const QString layerName = QFileInfo(filePath).baseName();
    if (mEditor && mEditor->layers()) {
        mEditor->layers()->createBitmapLayer(layerName);
    }

    // Ensure we import at frame 1
    if (mEditor) {
        mEditor->scrubTo(1);
    }

    // Configure import at canvas center (0,0) on frame 1
    ImportImageConfig cfg;
    cfg.importFrame = 1;
    cfg.positionType = ImportImageConfig::CenterOfCanvas;

    // Perform import
    Status st = mEditor->importImage(filePath, cfg);
    if (!st.ok()) {
        ErrorDialog errorDialog(st.title(), st.description(), st.details().html(), this);
        errorDialog.exec();
        return;
    }

    // Refresh the timeline to show the new layer/content
    if (mTimeLine) {
        mTimeLine->updateContent();
    }
}

void MainWindow2::importImageSequenceNew()
{
    // a) File selection
    const QStringList files = FileDialog::getOpenFileNames(this, FileType::IMAGE);
    if (files.isEmpty()) return;

    // b) Parse and group
    QMap<QString, QList<ImageSequenceFileInfo>> groups; // baseName -> files
    int validCount = 0;
    for (const QString& fp : files) {
        ImageSequenceFileInfo p = parseImageSequencePadding(fp);
        if (!p.valid()) continue;
        groups[p.baseName].append(p);
        ++validCount;
    }
    if (validCount == 0 || groups.isEmpty()) {
        ErrorDialog dlg(tr("Import Image Sequence"),
                        tr("No valid sequence padding found."),
                        tr("Expected formats: name_###, name-###, name.###, name_####, name-####, name.####"),
                        this);
        dlg.exec();
        return;
    }

    // c) Progress dialog
    QProgressDialog progress(tr("Importing image sequence..."), tr("Abort"), 0, validCount, this);
    progress.setWindowModality(Qt::WindowModal);
    hideQuestionMark(progress);
    progress.show();

    int imported = 0;
    for (auto it = groups.constBegin(); it != groups.constEnd(); ++it) {
        if (progress.wasCanceled()) break;

        const QString baseName = it.key();
        QList<ImageSequenceFileInfo> seq = it.value();
        std::sort(seq.begin(), seq.end(), [](const ImageSequenceFileInfo& a, const ImageSequenceFileInfo& b){
            return a.frameNumber < b.frameNumber;
        });

        // Create layer for this sequence with a unique name (auto-selects as current)
        if (mEditor && mEditor->layers()) {
            auto* layers = mEditor->layers();
            const QString uniqueName = layers->nameSuggestLayer(baseName);
            layers->createBitmapLayer(uniqueName);
        }

        // Import files
        for (const ImageSequenceFileInfo& f : seq) {
            if (progress.wasCanceled()) break;

            const int clampedFrame = std::max(1, f.frameNumber);
            mEditor->scrubTo(clampedFrame);

            ImportImageConfig cfg;
            cfg.importFrame = clampedFrame;
            cfg.positionType = ImportImageConfig::CenterOfCanvas;

            Status st = mEditor->importImage(f.filePath, cfg);
            if (!st.ok()) {
                ErrorDialog err(st.title(), st.description(), st.details().html(), this);
                err.exec();
                break;
            }

            ++imported;
            progress.setValue(imported);
            QApplication::processEvents(QEventLoop::ExcludeUserInputEvents);
        }
    }

    progress.close();
    if (mTimeLine) mTimeLine->updateContent();
}

