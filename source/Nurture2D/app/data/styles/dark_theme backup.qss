/* Dark theme inspired by TVPaint 12; scoped to QMainWindow#MainWindow2 to avoid custom widgets. */

/* Global dark styling for common dialogs to ensure cross-platform consistency */
QDialog, QMessageBox, QInputDialog {
  background-color: #2f2f2f;
  color: #e6e6e6;
}
QDialog QPushButton, QMessageBox QPushButton, QInputDialog QPushButton {
  background: #333333;
  color: #e6e6e6;
  border: 1px solid #3a3a3a;
  padding: 4px 8px;
}
QDialog QPushButton:hover, QMessageBox QPushButton:hover, QInputDialog QPushButton:hover {
  background: #3a3a3a;
}
QDialog QLineEdit, QDialog QListView, QDialog QTreeView, QDialog QTextEdit,
QMessageBox QLineEdit, QInputDialog QLineEdit {
  background: #404040;
  color: #e6e6e6;
  border: 1px solid #3a3a3a;
}

/* Dialog group boxes */
QDialog QGroupBox, QMessageBox QGroupBox {
  background: #404040;
  color: #e6e6e6;
  border: 1px solid #3a3a3a;
  border-radius: 4px;
  margin-top: 16px; /* extra space for title rendering */
  padding-top: 8px; /* keep content clear of title */
}
QDialog QGroupBox::title, QMessageBox QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 8px;
  padding: 3px 5px 3px 5px; /* vertical padding to avoid clipping */
  background: #404040;
  border-radius: 3px;
}

/* Root surfaces */
QMainWindow#MainWindow2,
QMainWindow#MainWindow2 QWidget#background {
  background-color: #262626;
  color: #e6e6e6;
}

/* Menubar & Menus */
QMainWindow#MainWindow2 QMenuBar { background: #333333; color: #e6e6e6; }
QMainWindow#MainWindow2 QMenuBar::item:selected { background: #3d3d3d; }
QMainWindow#MainWindow2 QMenu { background: #2f2f2f; color: #e6e6e6; border: 1px solid #3a3a3a; }
QMainWindow#MainWindow2 QMenu::item:selected { background: #3d3d3d; }

/* Toolbars */
QMainWindow#MainWindow2 QToolBar { background: #2f2f2f; border: 1px solid #3a3a3a; }
QMainWindow#MainWindow2 QToolBar QToolButton {
  background: transparent; color: #e6e6e6; border: 1px solid transparent; padding: 4px 6px;
}
QMainWindow#MainWindow2 QToolBar QToolButton:hover { background: #3a3a3a; border-color: #3a3a3a; }
QMainWindow#MainWindow2 QToolBar QToolButton:checked { background: #3d3d3d; border-color: #3a3a3a; }

/* Tool dock buttons: make active tool a glowing yellow circle (blender slider yellow) */
QMainWindow#MainWindow2 QWidget#ToolBoxWidget QToolButton {
  background: transparent;
  border: 1px solid transparent;
  padding: 6px;
  border-radius: 14px; /* circular background for ~28px icon buttons */
}
QMainWindow#MainWindow2 QWidget#ToolBoxWidget QToolButton:hover {
  background: rgba(255, 170, 64, 0.12);
  border-color: rgba(255, 170, 64, 0.35);
}
QMainWindow#MainWindow2 QWidget#ToolBoxWidget QToolButton:checked {
  /* Radial gradient to simulate a soft glow */
  background: qradialgradient(cx:0.5, cy:0.5, radius:0.6,
                              fx:0.5, fy:0.5,
                              stop:0 rgba(255,170,64,0.45),
                              stop:0.55 rgba(255,170,64,0.22),
                              stop:1 rgba(255,170,64,0.0));
  border-color: rgba(255, 170, 64, 0.85);
}
QMainWindow#MainWindow2 QWidget#ToolBoxWidget QToolButton:checked:hover {
  background: rgba(255, 170, 64, 0.28);
  border-color: rgba(255, 170, 64, 1.0);
}

/* Dock widgets body (custom title bars are handled elsewhere) */
QMainWindow#MainWindow2 QDockWidget { background: #404040; }
QMainWindow#MainWindow2 QDockWidget > QWidget { background: #404040; }

/* Scroll areas and frames */
QMainWindow#MainWindow2 QScrollArea,
QMainWindow#MainWindow2 QScrollArea > QWidget,
QMainWindow#MainWindow2 QScrollArea > QWidget > QWidget { background: #404040; }
QMainWindow#MainWindow2 QFrame { background: #404040; border-color: #1f1f1f; }

/* Group boxes */
QMainWindow#MainWindow2 QGroupBox { background: #404040; color: #e6e6e6; border: 1px solid #3a3a3a; margin-top: 8px; }
QMainWindow#MainWindow2 QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 3px; }

/* Labels */
QMainWindow#MainWindow2 QLabel { color: #e6e6e6; }

/* Buttons */
QMainWindow#MainWindow2 QPushButton,
QMainWindow#MainWindow2 QToolButton {
  background: #333333; color: #e6e6e6; border: 1px solid #3a3a3a; padding: 4px 8px;
}
QMainWindow#MainWindow2 QPushButton:hover,
QMainWindow#MainWindow2 QToolButton:hover { background: #3a3a3a; }
QMainWindow#MainWindow2 QPushButton:pressed,
QMainWindow#MainWindow2 QToolButton:pressed { background: #3d3d3d; }
QMainWindow#MainWindow2 QPushButton:disabled,
QMainWindow#MainWindow2 QToolButton:disabled { color: #bdbdbd; border-color: #3a3a3a; }

/* Line edits */
QMainWindow#MainWindow2 QLineEdit,
QMainWindow#MainWindow2 QTextEdit,
QMainWindow#MainWindow2 QPlainTextEdit {
  background: #2f2f2f; color: #e6e6e6; border: 1px solid #3a3a3a;
}

/* ComboBoxes */
QMainWindow#MainWindow2 QComboBox { background: #2f2f2f; border: 1px solid #3a3a3a; color: #e6e6e6; }
QMainWindow#MainWindow2 QComboBox QAbstractItemView { background: #2f2f2f; color: #e6e6e6; selection-background-color: #3d3d3d; }
QMainWindow#MainWindow2 QComboBox::drop-down { border-left: 1px solid #3a3a3a; }
QMainWindow#MainWindow2 QComboBox::down-arrow { image: none; width: 0; height: 0; }

/* Spinboxes */
QMainWindow#MainWindow2 QSpinBox,
QMainWindow#MainWindow2 QDoubleSpinBox {
  background: #2f2f2f; color: #e6e6e6; border: 1px solid #3a3a3a;
}
QMainWindow#MainWindow2 QAbstractSpinBox::up-button,
QMainWindow#MainWindow2 QAbstractSpinBox::down-button { background: #333333; border-left: 1px solid #3a3a3a; }

/* Sliders */
QMainWindow#MainWindow2 QSlider::groove:horizontal { height: 6px; background: #333333; border: 1px solid #1f1f1f; }
QMainWindow#MainWindow2 QSlider::handle:horizontal { background: #8a8a8a; width: 12px; margin: -4px 0; border-radius: 3px; }
QMainWindow#MainWindow2 QSlider::groove:vertical { width: 6px; background: #333333; border: 1px solid #1f1f1f; }
QMainWindow#MainWindow2 QSlider::handle:vertical { background: #8a8a8a; height: 12px; margin: 0 -4px; border-radius: 3px; }

/* Blender-like slider fallback styles */
QMainWindow#MainWindow2 QSlider::groove:horizontal { height: 18px; background: #282828; border: 1px solid #1f1f1f; border-radius: 4px; }
QMainWindow#MainWindow2 QSlider::handle:horizontal { width: 0px; background: transparent; }
QMainWindow#MainWindow2 QSlider::add-page:horizontal { background: #003366; border-radius: 4px; } /* active filled (navy) */
QMainWindow#MainWindow2 QSlider::sub-page:horizontal { background: #282828; border-radius: 4px; }

/* Checkboxes & Radios */
QMainWindow#MainWindow2 QCheckBox, QMainWindow#MainWindow2 QRadioButton { color: #e6e6e6; }
QMainWindow#MainWindow2 QCheckBox::indicator, QMainWindow#MainWindow2 QRadioButton::indicator { background: #2f2f2f; border: 1px solid #3a3a3a; width: 13px; height: 13px; }
QMainWindow#MainWindow2 QCheckBox::indicator:checked { background: transparent; }
QMainWindow#MainWindow2 QCheckBox::indicator:unchecked { background: transparent; }
QMainWindow#MainWindow2 QRadioButton::indicator:checked { background: #00a7ff; border-radius: 7px; }

/* Lists, Trees, Tables */
QMainWindow#MainWindow2 QAbstractItemView { background: #2f2f2f; color: #e6e6e6; alternate-background-color: #404040; }
QMainWindow#MainWindow2 QAbstractItemView::item:selected { background: #3d3d3d; color: #e6e6e6; }
QMainWindow#MainWindow2 QHeaderView::section { background: #333333; color: #e6e6e6; border: 1px solid #3a3a3a; }

/* Tabs */
QMainWindow#MainWindow2 QTabWidget::pane { border: 1px solid #3a3a3a; background: #404040; }
QMainWindow#MainWindow2 QTabBar::tab:top {
  background: #2e2e2e;
  color: #e6e6e6;
  padding: 4px 12px;
  border: 1px solid #3a3a3a;
  border-bottom: none;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  margin-right: 2px;
  min-width: 60px;
}
QMainWindow#MainWindow2 QTabBar::tab:top:selected {
  background: #3d3d3d;
  color: #ffffff;
}
QMainWindow#MainWindow2 QTabBar::tab:top:hover {
  background: #383838;
}

/* Splitters */
QMainWindow#MainWindow2 QSplitter::handle { background: #3a3a3a; }

/* Scrollbars */
QMainWindow#MainWindow2 QScrollBar:vertical, QMainWindow#MainWindow2 QScrollBar:horizontal { background: #2f2f2f; }
QMainWindow#MainWindow2 QScrollBar::handle:vertical, QMainWindow#MainWindow2 QScrollBar::handle:horizontal { background: #606060; }
QMainWindow#MainWindow2 QScrollBar::add-line, QMainWindow#MainWindow2 QScrollBar::sub-line { background: #333333; }

/* Status bar */
QMainWindow#MainWindow2 QStatusBar { background: #2f2f2f; color: #ffffff; }

/* Tooltips */
QMainWindow#MainWindow2 QToolTip { background: #333333; color: #e6e6e6; border: 1px solid #3a3a3a; }

/* Progress bar */
QMainWindow#MainWindow2 QProgressBar { background: #2f2f2f; color: #e6e6e6; border: 1px solid #3a3a3a; }
QMainWindow#MainWindow2 QProgressBar::chunk { background: #00a7ff; }

/* Avoid styling custom classes: SpinSlider, BackgroundWidget, ScribbleArea, ColorBox, PenColorPalette, TimeLine, etc. */ 

/* Title areas */
QMainWindow#MainWindow2 QDockWidget::title {
  background: #2b2b2b;
  color: #e6e6e6;
  padding-left: 6px;
}
QMainWindow#MainWindow2 QDockWidget {
  titlebar-close-icon: none;
  titlebar-normal-icon: none;
}
/* Our custom titlebar uses palette Midlight/Mid; ensure darker values */
QMainWindow#MainWindow2 QWidget#TitleBarWidget, /* if objectName set */
QMainWindow#MainWindow2 QWidget[objectName^="TitleBar"] {
  background: #2b2b2b;
} 

/* Custom checkbox icons */
QMainWindow#MainWindow2 QCheckBox::indicator {
  width: 16px; height: 16px;
}
QMainWindow#MainWindow2 QCheckBox::indicator:unchecked {
  image: url(:/Interaction/CheckboxEmpty.svg);
}
QMainWindow#MainWindow2 QCheckBox::indicator:checked {
  image: url(:/Interaction/CheckboxChecked.svg);
} 

/* Vertical fallback styles mirroring horizontal */
QMainWindow#MainWindow2 QSlider::groove:vertical { width: 18px; background: #282828; border: 1px solid #1f1f1f; border-radius: 4px; }
QMainWindow#MainWindow2 QSlider::handle:vertical { height: 0px; background: transparent; }
QMainWindow#MainWindow2 QSlider::add-page:vertical { background: #003366; border-radius: 4px; }
QMainWindow#MainWindow2 QSlider::sub-page:vertical { background: #282828; border-radius: 4px; } 

/* Selection highlights (menus, combo popups) use slider yellow */
QMainWindow#MainWindow2 QMenu::item:selected {
  background: #ffaa40;
  color: #1a1a1a;
}
QMainWindow#MainWindow2 QComboBox QAbstractItemView::item:selected {
  background: #ffaa40;
  color: #1a1a1a;
}
QMainWindow#MainWindow2 QTreeView::item:selected,
QMainWindow#MainWindow2 QListView::item:selected,
QMainWindow#MainWindow2 QTableView::item:selected {
  background: #ffaa40;
  color: #1a1a1a;
} 

/* Fallback: when popups are top-level (not under MainWindow2), keep same selection color */
QMenu::item:selected { background: #ffaa40; color: #1a1a1a; }
QAbstractItemView::item:selected { background: #ffaa40; color: #1a1a1a; }
QComboBox QAbstractItemView::item:selected { background: #ffaa40; color: #1a1a1a; } 